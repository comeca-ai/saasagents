{
  "name": "saasagents",
  "version": "2.0.0",
  "description": "Mesa dos Agentes: agentes de IA que rodam no GitHub Actions do cliente.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check .saasagents/run.mjs && node --check scripts/build-interface.mjs && node --check scripts/serve-interface.mjs",
    "interface": "node scripts/build-interface.mjs",
    "interface:serve": "node scripts/serve-interface.mjs",
    "legado:test": "cd legado/v0-cloudflare && node --test tests/*.test.js"
  }
}
