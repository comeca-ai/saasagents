{
  "name": "saasagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check public/app.js && node --check scripts/provision.mjs && node --check connector/cli.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply saasagents-v0 --local",
    "connector": "node connector/cli.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@playwright/test": "^1.56.0"
  }
}
